{
  "name": "@mage2/player-ui",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "rimraf dist && tsup src/index.ts --format esm,cjs --dts --external react --external react-dom",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mage2/player": "0.1.0",
    "@mage2/schema": "0.1.0"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9"
  }
}
